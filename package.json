{
  "engines": { "pnpm": ">=12" },
  "packageManager": "pnpm@12.6.0",
  "name": "service-ixcsoft",
  "description": "IXC Soft + Woovi PIX integration microservice",
  "version": "0.1.0",
  "author": "Woovi",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "tsgo": "tsgo",
    "typecheck": "tsgo --noEmit",
    "docker:build:local": "bash docker/build-local.sh",
    "docker:run": "bash docker/run.sh",
    "prepare": "husky",
    "docker:staging": "woovi-docker staging",
    "docker:staging:tekton": "woovi-docker staging --tekton --watch",
    "docker:production": "woovi-docker production",
    "docker:status": "woovi-docker status"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^7.3.9",
    "@sentry/nextjs": "^11.4.0",
    "@woovi/apiwithlog": "^2.8.0",
    "@woovi/logger": "^1.0.1",
    "bullmq": "^5.80.2",
    "elastic-apm-node": "^4.13.0",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.4",
    "next": "16.2.10",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "^7.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@woovi-private/docker-build": "^0.2.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "wooviDocker": {
    "image": "woovi/service-woovi-ixcsoft",
    "prebuild": "rm -rf .next && pnpm build"
  }
}
